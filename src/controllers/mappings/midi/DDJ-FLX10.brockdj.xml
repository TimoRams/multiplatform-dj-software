<?xml version="1.0" encoding="UTF-8"?>
<BrockDJControllerMapping version="1" id="ddj-flx10" name="DDJ-FLX10" vendor="Pioneer DJ">
  <Source
    reference="https://github.com/Veezuhz/Mixxx_FLX10_Controller_Mapping"
    note="MIDI status/control values were referenced from the DDJ-FLX10 repository. This file is a BrockDJ-native mapping."/>

  <Mappings>
    <!-- Transport -->
    <Entry paramId="deckA_play" status="0x90" control="0x0B" type="toggle"/>
    <Entry paramId="deckB_play" status="0x91" control="0x0B" type="toggle"/>
    <Entry paramId="deckA_cue" status="0x90" control="0x0C" type="momentary"/>
    <Entry paramId="deckB_cue" status="0x91" control="0x0C" type="momentary"/>
    <Entry paramId="deckA_beat_sync" status="0x90" control="0x58" type="toggle"/>
    <Entry paramId="deckB_beat_sync" status="0x91" control="0x58" type="toggle"/>
    <Entry paramId="deckA_beatsync" status="0x90" control="0x66" type="toggle"/>
    <Entry paramId="deckB_beatsync" status="0x91" control="0x66" type="toggle"/>
    <Entry paramId="deckA_key_sync" status="0x90" control="0x65" type="toggle"/>
    <Entry paramId="deckB_key_sync" status="0x91" control="0x65" type="toggle"/>
    <Entry paramId="deckA_keylock" status="0x90" control="0x1C" type="toggle"/>
    <Entry paramId="deckB_keylock" status="0x91" control="0x1C" type="toggle"/>
    <Entry paramId="deckA_slip" status="0x90" control="0x40" type="toggle"/>
    <Entry paramId="deckB_slip" status="0x91" control="0x40" type="toggle"/>
    <Entry paramId="deckA_tempo_reset" status="0x90" control="0x41" type="toggle"/>
    <Entry paramId="deckB_tempo_reset" status="0x91" control="0x41" type="toggle"/>
    <Entry paramId="deckA_rate_reset" status="0x90" control="0x46" type="toggle"/>
    <Entry paramId="deckB_rate_reset" status="0x91" control="0x46" type="toggle"/>

    <!-- Tempo faders, 14-bit MSB. Matching LSB messages at +0x20 are combined automatically. -->
    <Entry paramId="deckA_tempo" status="0xB0" control="0x00" type="fader"/>
    <Entry paramId="deckB_tempo" status="0xB1" control="0x00" type="fader"/>

    <!-- Jog wheels. CC 0x22 = touched top-platter scratch only; CC 0x21 = rim / post-release free spin. Relative values centered at 0x40. One physical revolution is approximately 12750 accumulated ticks at 33 1/3 RPM (about 1.8 s). -->
    <Entry paramId="deckA_jog_nudge" status="0xB0" control="0x21" type="encoder-relative"/>
    <Entry paramId="deckB_jog_nudge" status="0xB1" control="0x21" type="encoder-relative"/>
    <Entry paramId="deckA_jog_scratch" status="0xB0" control="0x22" type="encoder-relative"/>
    <Entry paramId="deckB_jog_scratch" status="0xB1" control="0x22" type="encoder-relative"/>
    <Entry paramId="deckA_jog_touch" status="0x90" control="0x36" type="momentary"/>
    <Entry paramId="deckB_jog_touch" status="0x91" control="0x36" type="momentary"/>

    <!-- Loop controls. Loop In/Out become halve/double while a loop is active. Shift + 4 Beat clears the current loop. -->
    <Entry paramId="deckA_shift" status="0x90" control="0x3F" type="momentary"/>
    <Entry paramId="deckB_shift" status="0x91" control="0x3F" type="momentary"/>
    <Entry paramId="deckA_loop_in" status="0x90" control="0x10" type="toggle"/>
    <Entry paramId="deckB_loop_in" status="0x91" control="0x10" type="toggle"/>
    <Entry paramId="deckA_loop_out" status="0x90" control="0x11" type="toggle"/>
    <Entry paramId="deckB_loop_out" status="0x91" control="0x11" type="toggle"/>
    <Entry paramId="deckA_loop_4beat" status="0x90" control="0x12" type="toggle"/>
    <Entry paramId="deckB_loop_4beat" status="0x91" control="0x12" type="toggle"/>
    <Entry paramId="deckA_loop_reloop" status="0x90" control="0x14" type="toggle"/>
    <Entry paramId="deckB_loop_reloop" status="0x91" control="0x14" type="toggle"/>
    <Entry paramId="deckA_loop_in_adjust" status="0x90" control="0x4C" type="toggle"/>
    <Entry paramId="deckB_loop_in_adjust" status="0x91" control="0x4C" type="toggle"/>
    <Entry paramId="deckA_loop_out_adjust" status="0x90" control="0x4D" type="toggle"/>
    <Entry paramId="deckB_loop_out_adjust" status="0x91" control="0x4D" type="toggle"/>

    <!-- Performance pads. The active BrockDJ pad mode decides whether these trigger Hot Cues, Pad FX, or Beatjump. -->
    <Entry paramId="deckA_pad_mode_hotcue" status="0x97" control="0x40" type="toggle"/>
    <Entry paramId="deckA_pad_mode_padfx" status="0x97" control="0x41" type="toggle"/>
    <Entry paramId="deckA_pad_mode_beatjump" status="0x97" control="0x42" type="toggle"/>
    <Entry paramId="deckB_pad_mode_hotcue" status="0x99" control="0x40" type="toggle"/>
    <Entry paramId="deckB_pad_mode_padfx" status="0x99" control="0x41" type="toggle"/>
    <Entry paramId="deckB_pad_mode_beatjump" status="0x99" control="0x42" type="toggle"/>

    <Entry paramId="deckA_pad1" status="0x97" control="0x00" type="momentary"/>
    <Entry paramId="deckA_pad2" status="0x97" control="0x01" type="momentary"/>
    <Entry paramId="deckA_pad3" status="0x97" control="0x02" type="momentary"/>
    <Entry paramId="deckA_pad4" status="0x97" control="0x03" type="momentary"/>
    <Entry paramId="deckA_pad5" status="0x97" control="0x04" type="momentary"/>
    <Entry paramId="deckA_pad6" status="0x97" control="0x05" type="momentary"/>
    <Entry paramId="deckA_pad7" status="0x97" control="0x06" type="momentary"/>
    <Entry paramId="deckA_pad8" status="0x97" control="0x07" type="momentary"/>
    <Entry paramId="deckA_pad1_clear" status="0x98" control="0x00" type="toggle"/>
    <Entry paramId="deckA_pad2_clear" status="0x98" control="0x01" type="toggle"/>
    <Entry paramId="deckA_pad3_clear" status="0x98" control="0x02" type="toggle"/>
    <Entry paramId="deckA_pad4_clear" status="0x98" control="0x03" type="toggle"/>
    <Entry paramId="deckA_pad5_clear" status="0x98" control="0x04" type="toggle"/>
    <Entry paramId="deckA_pad6_clear" status="0x98" control="0x05" type="toggle"/>
    <Entry paramId="deckA_pad7_clear" status="0x98" control="0x06" type="toggle"/>
    <Entry paramId="deckA_pad8_clear" status="0x98" control="0x07" type="toggle"/>

    <Entry paramId="deckB_pad1" status="0x99" control="0x00" type="momentary"/>
    <Entry paramId="deckB_pad2" status="0x99" control="0x01" type="momentary"/>
    <Entry paramId="deckB_pad3" status="0x99" control="0x02" type="momentary"/>
    <Entry paramId="deckB_pad4" status="0x99" control="0x03" type="momentary"/>
    <Entry paramId="deckB_pad5" status="0x99" control="0x04" type="momentary"/>
    <Entry paramId="deckB_pad6" status="0x99" control="0x05" type="momentary"/>
    <Entry paramId="deckB_pad7" status="0x99" control="0x06" type="momentary"/>
    <Entry paramId="deckB_pad8" status="0x99" control="0x07" type="momentary"/>
    <Entry paramId="deckB_pad1_clear" status="0x9A" control="0x00" type="toggle"/>
    <Entry paramId="deckB_pad2_clear" status="0x9A" control="0x01" type="toggle"/>
    <Entry paramId="deckB_pad3_clear" status="0x9A" control="0x02" type="toggle"/>
    <Entry paramId="deckB_pad4_clear" status="0x9A" control="0x03" type="toggle"/>
    <Entry paramId="deckB_pad5_clear" status="0x9A" control="0x04" type="toggle"/>
    <Entry paramId="deckB_pad6_clear" status="0x9A" control="0x05" type="toggle"/>
    <Entry paramId="deckB_pad7_clear" status="0x9A" control="0x06" type="toggle"/>
    <Entry paramId="deckB_pad8_clear" status="0x9A" control="0x07" type="toggle"/>

    <!-- Dedicated 4 Beat Jump buttons are CCs on the deck channels. -->
    <Entry paramId="deckA_beatjump_4_forward" status="0xB0" control="0x29" type="toggle"/>
    <Entry paramId="deckB_beatjump_4_forward" status="0xB1" control="0x29" type="toggle"/>
    <Entry paramId="deckA_beatjump_4_backward" status="0xB0" control="0x1F" type="toggle"/>
    <Entry paramId="deckB_beatjump_4_backward" status="0xB1" control="0x1F" type="toggle"/>

    <!-- Beat FX section, MIDI channel 5 in FLX10 terms. -->
    <Entry paramId="beat_fx_select_1" status="0x94" control="0x20" type="toggle"/>
    <Entry paramId="beat_fx_select_2" status="0x94" control="0x21" type="toggle"/>
    <Entry paramId="beat_fx_select_3" status="0x94" control="0x22" type="toggle"/>
    <Entry paramId="beat_fx_select_4" status="0x94" control="0x23" type="toggle"/>
    <Entry paramId="beat_fx_select_5" status="0x94" control="0x24" type="toggle"/>
    <Entry paramId="beat_fx_select_6" status="0x94" control="0x25" type="toggle"/>
    <Entry paramId="beat_fx_select_7" status="0x94" control="0x26" type="toggle"/>
    <Entry paramId="beat_fx_select_8" status="0x94" control="0x27" type="toggle"/>
    <Entry paramId="beat_fx_select_9" status="0x94" control="0x28" type="toggle"/>
    <Entry paramId="beat_fx_select_10" status="0x94" control="0x29" type="toggle"/>
    <Entry paramId="beat_fx_select_11" status="0x94" control="0x2A" type="toggle"/>
    <Entry paramId="beat_fx_select_12" status="0x94" control="0x2B" type="toggle"/>
    <Entry paramId="beat_fx_select_13" status="0x94" control="0x2C" type="toggle"/>
    <Entry paramId="beat_fx_select_14" status="0x94" control="0x2D" type="toggle"/>
    <Entry paramId="beat_fx_channel_deck_b" status="0x94" control="0x10" type="toggle"/>
    <Entry paramId="beat_fx_channel_deck_a" status="0x94" control="0x11" type="toggle"/>
    <Entry paramId="beat_fx_on" status="0x94" control="0x46" type="toggle"/>

    <!-- Mixer. 14-bit LSB messages at +0x20 are paired by MidiControllerManager where present. -->
    <Entry paramId="deckA_gain" status="0xB0" control="0x04" type="encoder-absolute"/>
    <Entry paramId="deckB_gain" status="0xB1" control="0x04" type="encoder-absolute"/>
    <Entry paramId="deckA_eqHigh" status="0xB0" control="0x07" type="encoder-absolute"/>
    <Entry paramId="deckB_eqHigh" status="0xB1" control="0x07" type="encoder-absolute"/>
    <Entry paramId="deckA_eqMid" status="0xB0" control="0x0B" type="encoder-absolute"/>
    <Entry paramId="deckB_eqMid" status="0xB1" control="0x0B" type="encoder-absolute"/>
    <Entry paramId="deckA_eqLow" status="0xB0" control="0x0F" type="encoder-absolute"/>
    <Entry paramId="deckB_eqLow" status="0xB1" control="0x0F" type="encoder-absolute"/>
    <Entry paramId="deckA_filter" status="0xB6" control="0x17" type="encoder-absolute"/>
    <Entry paramId="deckB_filter" status="0xB6" control="0x18" type="encoder-absolute"/>
    <Entry paramId="deckA_vol" status="0xB0" control="0x13" type="fader"/>
    <Entry paramId="deckB_vol" status="0xB1" control="0x13" type="fader"/>
    <Entry paramId="crossfader" status="0xB6" control="0x1F" type="fader"/>

    <!-- Monitoring and library. -->
    <Entry paramId="headphone_mix" status="0xB6" control="0x0C" type="fader"/>
    <Entry paramId="deckA_headphone_cue" status="0x90" control="0x54" type="toggle"/>
    <Entry paramId="deckB_headphone_cue" status="0x91" control="0x54" type="toggle"/>
    <Entry paramId="library_browse" status="0xB6" control="0x40" type="encoder-relative"/>
    <Entry paramId="library_load_deck_a" status="0x96" control="0x46" type="toggle"/>
    <Entry paramId="library_load_deck_b" status="0x96" control="0x47" type="toggle"/>
  </Mappings>

  <Feedback protocol="midi">
    <!-- Normal deck LEDs use Note feedback on channels 1-4. Values are 0x00 off, 0x7F on. -->
    <DeckStatus deck="1" status="0x90"/>
    <DeckStatus deck="2" status="0x91"/>
    <DeckStatus deck="3" status="0x92"/>
    <DeckStatus deck="4" status="0x93"/>
    <DeckLed name="play" control="0x0B"/>
    <DeckLed name="cue" control="0x0C"/>
    <DeckLed name="loop_in" control="0x10"/>
    <DeckLed name="loop_out" control="0x11"/>
    <DeckLed name="loop_4beat" control="0x12"/>
    <DeckLed name="loop_reloop" control="0x14"/>
    <DeckLed name="tempo_reset" control="0x41"/>
    <DeckLed name="beat_sync" control="0x58"/>
    <DeckLed name="key_sync" control="0x65"/>

    <!-- RGB pads are palette-index Note feedback, not raw RGB. -->
    <HotcuePads deck="1" status="0x97" shiftStatus="0x98" firstControl="0x00"/>
    <HotcuePads deck="2" status="0x99" shiftStatus="0x9A" firstControl="0x00"/>
    <HotcuePads deck="3" status="0x9B" shiftStatus="0x9C" firstControl="0x00"/>
    <HotcuePads deck="4" status="0x9D" shiftStatus="0x9E" firstControl="0x00"/>

    <PadPalette>
      <Color name="blue" value="0x01"/>
      <Color name="cyan" value="0x11"/>
      <Color name="green" value="0x15"/>
      <Color name="yellow" value="0x1D"/>
      <Color name="orange" value="0x25"/>
      <Color name="red" value="0x29"/>
      <Color name="pink" value="0x35"/>
      <Color name="magenta" value="0x39"/>
      <Color name="purple" value="0x3D"/>
      <Color name="white" value="0x7F"/>
    </PadPalette>

    <!-- VU meters use CC 0x02 on deck channels 1-4. -->
    <VuMeter deck="1" status="0xB0" control="0x02"/>
    <VuMeter deck="2" status="0xB1" control="0x02"/>
    <VuMeter deck="3" status="0xB2" control="0x02"/>
    <VuMeter deck="4" status="0xB3" control="0x02"/>
  </Feedback>
</BrockDJControllerMapping>
