{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BROCKDJ_ENABLE_NATIVE_ARCH": "OFF",
        "BUILD_TESTING": "ON",
        "RDBJ_ENABLE_QML_CACHEGEN": "ON"
      }
    },
    {
      "name": "ci-linux-x64",
      "displayName": "CI Linux x86_64",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-linux-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-linux-arm64",
      "displayName": "CI Linux ARM64",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-linux-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-linux-sanitizers",
      "displayName": "CI Linux ASan and UBSan",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-linux-sanitizers",
      "cacheVariables": {
        "BROCKDJ_ENABLE_SANITIZERS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-macos-arm64",
      "displayName": "CI macOS Apple Silicon",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-macos-x86_64",
      "displayName": "CI macOS Intel",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-windows-x64",
      "displayName": "CI Windows x64 (MSVC)",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-windows-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "ci-linux-x64", "configurePreset": "ci-linux-x64" },
    { "name": "ci-linux-arm64", "configurePreset": "ci-linux-arm64" },
    { "name": "ci-linux-sanitizers", "configurePreset": "ci-linux-sanitizers" },
    { "name": "ci-macos-arm64", "configurePreset": "ci-macos-arm64" },
    { "name": "ci-macos-x86_64", "configurePreset": "ci-macos-x86_64" },
    { "name": "ci-windows-x64", "configurePreset": "ci-windows-x64" }
  ],
  "testPresets": [
    {
      "name": "ci-linux-x64",
      "configurePreset": "ci-linux-x64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-linux-arm64",
      "configurePreset": "ci-linux-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-linux-sanitizers",
      "configurePreset": "ci-linux-sanitizers",
      "filter": {
        "include": {
          "name": "^(startup_close_smoke|startup_early_close_smoke|smoke|deck_audio_graph|audio_page_cache|scratch_cache|cached_playback|waveform_cache_repair|scratch_motion|waveform_motion|control_clock|neutral_waveform_analysis|database_worker|media_io_scheduler)$"
        }
      },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-macos-arm64",
      "configurePreset": "ci-macos-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-macos-x86_64",
      "configurePreset": "ci-macos-x86_64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-windows-x64",
      "configurePreset": "ci-windows-x64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
