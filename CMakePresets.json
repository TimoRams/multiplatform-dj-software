{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-dev-fast",
      "displayName": "Linux dev fast",
      "description": "Fast local Linux build: Ninja, RelWithDebInfo, QML cachegen disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "description": "Release-like Linux build with QML cachegen enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDBJ_ENABLE_QML_CACHEGEN": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-dev-fast",
      "configurePreset": "linux-dev-fast"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}
