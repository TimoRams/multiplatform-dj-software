{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-dev-fast",
      "displayName": "Linux dev fast",
      "description": "Fast local Linux build: Ninja, RelWithDebInfo, QML cachegen disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "description": "Release-like Linux build with QML cachegen enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDBJ_ENABLE_QML_CACHEGEN": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-dev-arm64",
      "displayName": "macOS dev (Apple Silicon)",
      "description": "Local macOS ARM64 dev build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-dev-x86_64",
      "displayName": "macOS dev (Intel)",
      "description": "Local Intel Mac dev build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-dev-fast",
      "configurePreset": "linux-dev-fast"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-dev-arm64",
      "configurePreset": "macos-dev-arm64"
    },
    {
      "name": "macos-dev-x86_64",
      "configurePreset": "macos-dev-x86_64"
    }
  ],
  "testPresets": [
    {
      "name": "linux-dev-fast",
      "configurePreset": "linux-dev-fast",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
