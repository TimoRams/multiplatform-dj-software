{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-dev-fast",
      "displayName": "Linux dev fast",
      "description": "Fast local Linux build: Ninja, RelWithDebInfo, QML cachegen disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "BROCKDJ_TESTS_ONLY": "OFF",
        "BROCKDJ_AUTOGEN_PARALLEL": "4",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-tests-fast",
      "displayName": "Linux tests fast",
      "description": "Separate local test build: Ninja, RelWithDebInfo, application excluded from all.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "BROCKDJ_TESTS_ONLY": "ON",
        "BROCKDJ_AUTOGEN_PARALLEL": "4",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "description": "Release-like Linux build with QML cachegen enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDBJ_ENABLE_QML_CACHEGEN": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-dev-arm64",
      "displayName": "macOS dev (Apple Silicon)",
      "description": "Local macOS ARM64 dev build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-dev-x86_64",
      "displayName": "macOS dev (Intel)",
      "description": "Local Intel Mac dev build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "RDBJ_ENABLE_QML_CACHEGEN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BROCKDJ_ENABLE_NATIVE_ARCH": "OFF",
        "BUILD_TESTING": "ON",
        "RDBJ_ENABLE_QML_CACHEGEN": "ON"
      }
    },
    {
      "name": "ci-linux-x64",
      "displayName": "CI Linux x86_64",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-linux-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-linux-arm64",
      "displayName": "CI Linux ARM64",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-linux-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ci-macos-arm64",
      "displayName": "CI macOS Apple Silicon",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-macos-x86_64",
      "displayName": "CI macOS Intel",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-windows-x64",
      "displayName": "CI Windows x64 (MSVC)",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci-windows-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-dev-fast", "configurePreset": "linux-dev-fast" },
    { "name": "linux-tests-fast", "configurePreset": "linux-tests-fast" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-dev-arm64", "configurePreset": "macos-dev-arm64" },
    { "name": "macos-dev-x86_64", "configurePreset": "macos-dev-x86_64" },
    { "name": "ci-linux-x64", "configurePreset": "ci-linux-x64" },
    { "name": "ci-linux-arm64", "configurePreset": "ci-linux-arm64" },
    { "name": "ci-macos-arm64", "configurePreset": "ci-macos-arm64" },
    { "name": "ci-macos-x86_64", "configurePreset": "ci-macos-x86_64" },
    { "name": "ci-windows-x64", "configurePreset": "ci-windows-x64" }
  ],
  "testPresets": [
    {
      "name": "linux-dev-fast",
      "configurePreset": "linux-tests-fast",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-tests-fast",
      "configurePreset": "linux-tests-fast",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-linux-x64",
      "configurePreset": "ci-linux-x64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-linux-arm64",
      "configurePreset": "ci-linux-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-macos-arm64",
      "configurePreset": "ci-macos-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-macos-x86_64",
      "configurePreset": "ci-macos-x86_64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-windows-x64",
      "configurePreset": "ci-windows-x64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
